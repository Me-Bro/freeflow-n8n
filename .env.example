# Copy to .env and fill in. Never commit .env.

# Encrypts stored credentials. Generate once and keep it safe:
#   openssl rand -hex 32
# If you lose it, saved credentials can't be decrypted.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

N8N_HOST=localhost
# Port inside the container. The host port (15678) is set in docker-compose.yml.
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:15678/

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false

# ----- llm-gateway -----
# Key that callers (e.g. n8n) must send. Generate with: openssl rand -hex 32
GATEWAY_API_KEY=
# Free provider keys. Providers without a key are skipped.
# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
