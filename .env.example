# Copy to .env and fill in. Never commit .env.

# Encrypts stored credentials. Generate once and keep it safe:
#   openssl rand -hex 32
# If you lose it, saved credentials can't be decrypted.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
